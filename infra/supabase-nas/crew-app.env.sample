# ─────────────────────────────────────────────────────────────
# Variables à copier dans le `.env.local` de l'app Crew (racine du repo)
# pour qu'elle utilise le Supabase auto-hébergé sur le NAS.
#
# Remplace <IP_DU_NAS> par l'IP locale du NAS (ex: 192.168.1.50)
# ou ton nom de domaine si tu exposes la stack derrière un reverse proxy.
#
# Les valeurs ANON_KEY / SERVICE_ROLE_KEY proviennent de
# infra/supabase-nas/.env (générées par generate-keys.mjs).
# ─────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL="http://<IP_DU_NAS>:8000"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<ANON_KEY>"
SUPABASE_SERVICE_ROLE_KEY="<SERVICE_ROLE_KEY>"

# ─────────────────────────────────────────────────────────────
# Automatisations admin (génération des services + relances)
# ─────────────────────────────────────────────────────────────

# Secret partageant les routes /api/cron/* avec le planificateur pg_cron.
# Génère une valeur aléatoire et reporte-la AUSSI dans automation_config.cron_secret
# (table créée par la migration 20260609000002_cron_schedule.sql) :
#   insert into automation_config (key, value) values
#     ('app_base_url', 'http://crew-web:3000'),   -- URL interne au réseau Docker
#     ('cron_secret',  '<MÊME VALEUR QUE CI-DESSOUS>')
#   on conflict (key) do update set value = excluded.value;
CRON_SECRET="<genere-un-secret-aleatoire>"

# Notifications push (VAPID) — requis pour que les relances partent réellement.
# Génère les clés avec: npm run generate:vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY="<VAPID_PUBLIC_KEY>"
VAPID_PRIVATE_KEY="<VAPID_PRIVATE_KEY>"
VAPID_SUBJECT="mailto:admin@exemple.org"

# IA (pré-assignation des équipes). Sans clé → heuristique déterministe (suffit pour la génération).
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"
# AI_MOCK="true"   # force le mode mock (utile en test/CI)

# Tests/démo uniquement : fige la date de référence (ISO 8601).
# CREW_REFERENCE_TODAY="2025-06-09T08:00:00Z"
